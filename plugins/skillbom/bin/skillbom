#!/usr/bin/env bash
# Run the skillbom scanner bundled with this plugin.
# Needs Python >= 3.9 with PyYAML. Uses, in order: a python3 that already has PyYAML,
# `uv`, or a private venv created once under ~/.cache/skillbom.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

usable() {  # python >= 3.9?
  "$1" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null
}

for py in python3 /usr/bin/python3; do
  if command -v "$py" >/dev/null && usable "$py" && "$py" -c 'import yaml' 2>/dev/null; then
    exec "$py" -m skillbom "$@"
  fi
done

if command -v uv >/dev/null; then
  exec uv run --quiet --no-project --with 'pyyaml>=6' python -m skillbom "$@"
fi

VENV="${XDG_CACHE_HOME:-$HOME/.cache}/skillbom/venv"
if ! "$VENV/bin/python" -c 'import yaml' 2>/dev/null; then
  base=""
  for py in python3 /usr/bin/python3; do
    if command -v "$py" >/dev/null && usable "$py"; then base="$py"; break; fi
  done
  if [ -z "$base" ]; then
    echo "skillbom: needs Python 3.9 or newer (python3 not found)" >&2
    exit 1
  fi
  echo "skillbom: first run, installing PyYAML into $VENV" >&2
  "$base" -m venv "$VENV" >&2
  "$VENV/bin/python" -m pip install --quiet --disable-pip-version-check 'pyyaml>=6' >&2
fi
exec "$VENV/bin/python" -m skillbom "$@"
