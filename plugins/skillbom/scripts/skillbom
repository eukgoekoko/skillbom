#!/usr/bin/env bash
# Run the skillbom scanner bundled with this plugin.
# Needs only Python >= 3.9: the scanner and its one dependency (PyYAML, in vendor/)
# ship as readable source. Nothing is downloaded or installed, and nothing is sent anywhere.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$ROOT/src:$ROOT/vendor${PYTHONPATH:+:$PYTHONPATH}"

for py in python3 /usr/bin/python3; do
  if command -v "$py" >/dev/null && "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
    exec "$py" -m skillbom "$@"
  fi
done
echo "skillbom: needs Python 3.9 or newer (python3 not found)" >&2
exit 1
